# Generated by src/bundle.py. Rebuild it, don't commit it.
build/fusion_script.py

# Export outputs. Regenerable from the model plus a manifest; committing them
# means binary churn on every parameter tweak. Release artefacts belong on a
# tagged release, not in the working tree.
build/export/

__pycache__/
*.pyc
.DS_Store

# Fusion lock and backup files
*.f3d.lock
*.bak

# Fusion's script debugger writes this next to any script it runs.
build/.vscode/

# Manual exports dropped at the top level. Release files are attached to a
# tagged GitHub release, generated by src/fusion/export.py with a manifest; a
# loose STL here is always either stale or untraceable.
/*.stl
/*.3mf
/*.step
/*.f3d
